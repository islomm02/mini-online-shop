// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User{
  id String @id() @default(uuid())
  firstName String
  lastName String
  phone String @unique()
  email String @unique()
  year Int
  password String
  region Region @relation(fields: [regionId], references: [id])
  regionId String
  role UserRole @default(USER)
  status UserStatus @default(INACTIVE)
  image String?
  comments Comments[]
  likes Likes[]
  views Views[]
  orders Orders[]
  chatFrom Chat[] @relation("from")
  chatTo Chat[] @relation("to")
  messagesFrom Messages[] @relation("from")
  messagesTo Messages[] @relation("to")
  products Product[]

}

model Chat{
  id String @id() @default(uuid())
  from User @relation("from", fields: [fromId], references: [id])
  fromId String
  to User @relation("to", fields: [toId], references: [id])
  toId String
  messages Messages[]
}

model Messages{
  id String @id() @default(uuid())
  chat Chat @relation(fields: [chatId], references: [id])
  chatId String
  from User @relation("from", fields: [fromId], references: [id])
  fromId String
  to User @relation("to", fields: [toId], references: [id])
  toId String
  message String
}


model Region{
  id String @id() @default(uuid())
  name String
  users User[]
}

model Product{
  id String @id() @default(uuid())
  name  String
  description String
  price Int
  category Category @relation(fields: [categoryId], references: [id])
  categoryId String
  type Type @relation(fields: [typeId], references: [id])
  owner User @relation(fields: [ownerId], references: [id]) 
  ownerId String
  typeId String 
  xolati ProductXolati
  color Colors @relation(fields: [colorId], references: [id])
  colorId String
  count Int
  discount Int
  image String?
  like Int?
  star Int?
  comments Comments[]
  likes Likes[]
  views Views[]
  orders Orders[]
  createdAt DateTime @default(now())

}


model Comments{
  id String @id() @default(uuid())
  user User @relation(fields: [userId], references: [id])
  userId String
  products Product @relation(fields: [productId], references: [id])
  productId String
  star Int
  comment String
}

model Likes{
  id String @id() @default(uuid())
  users User @relation(fields: [userId], references: [id])
  userId String
  products Product @relation(fields: [productId], references: [id])
  productId String
}


model Views{
  id String @id() @default(uuid())
  users User @relation(fields: [userId], references: [id])
  userId String
  products Product @relation(fields: [productId], references: [id])
  productId String
  createdAt DateTime @default(now())
}

model Orders{
  id String @id() @default(uuid())
  users User @relation(fields: [userId], references: [id])
  userId String
  products Product @relation(fields: [productId], references: [id])
  productId String
  count Int
  colors Colors @relation(fields: [colorId], references: [id])
  colorId String
}

model Colors{

  id String @id() @default(uuid())
  name String
  products Product [] 
  orders Orders[]
}

model Type{
  id String @id() @default(uuid())
  name String
  products Product[]
}

model Category{
  id String @id() @default(uuid())
  name String
  products Product[]
}






enum UserRole{
  ADMIN
  USER
  SUPER_ADMIN
}

enum UserStatus{
  ACTIVE
  INACTIVE
}

enum ProductXolati{
  YANGI
  YAXSHI
  YOMON
}
